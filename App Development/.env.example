# Frontend Vite configuration
# Local Supabase defaults are shown below. Replace these with the values from
# `supabase status` after starting the local stack, or your hosted project values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Vite server configuration
# Use 0.0.0.0 for LAN testing. Keep PORT consistent with the command teammates use.
HOST=0.0.0.0
PORT=8443

# Optional public frontend configuration
VITE_APP_NAME=NER Logistics Platform
VITE_API_BASE_URL=http://127.0.0.1:54321

# Edge Function / Supabase server secrets are configured separately with:
# supabase secrets set KEY=value
# Never place SUPABASE_SERVICE_ROLE_KEY, provider keys, ML credentials, or
# database passwords in this file or in frontend-exposed VITE_ variables.
